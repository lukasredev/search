# Datasets and indexes are large and rebuilt by `make data index`. The two small files
# next to each index are kept: the hand-picked example queries and the benchmark results.
data/*
!data/index/
data/index/*/*
!data/index/*/demo_queries.json
!data/index/*/benchmark.json
target/
node_modules/
dist/
.venv/
__pycache__/
*.class
.DS_Store

# Local secrets (AUTH_PASS); .env.example is the committed template.
.env
.env.*
!.env.example
